# Copy this file to .env and fill in real values. Never commit .env to git.

# Supabase / PostgreSQL connection string
SQLALCHEMY_DATABASE_URI=postgresql://user:password@host:5432/database

# Flask JWT signing secret — use a long random string in production
SECRET_KEY=change-me-to-a-long-random-string

# Gmail (or SMTP) credentials for password-reset emails
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-app-password

# Supabase Storage — get from Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_API=your-supabase-anon-key
# Name of the storage bucket used for uploads (Project Settings → Storage).
# Must have public read access enabled — feed/ad images are served as direct
# public URLs, not proxied through the backend. If unset, the app falls back
# to whichever bucket list_buckets() returns first.
SUPABASE_BUCKET=your-bucket-name

# YouTube Data API v3 key — powers the SuperAdmin "YouTube channels" monitor
# (content-pipeline/youtube/*). Get one from Google Cloud Console:
#   console.cloud.google.com → create/select a project → APIs & Services →
#   Enable "YouTube Data API v3" → Credentials → Create credentials → API key.
# The channel add/list/remove routes are pure DB ops, but the "check for new
# uploads" route returns 503 until this is set. Leave blank to disable.
YOUTUBE_API_KEY=

# Alpha Vantage API key -- powers Gut Money's Investing page (stock
# quotes/charts/search) and economic indicators (CPI, unemployment, Fed
# funds rate, GDP). Free key, signup takes under a minute:
#   alphavantage.co/support/#api-key
# Free tier is 25 requests/day, 5/minute -- shared across every visitor to
# the whole site, not per-user, so finance_market.py caches every response
# in the database and only re-fetches once that cache goes stale (see
# CACHE_TTL there). Leave unset and it falls back to Alpha Vantage's public
# "demo" key, which only returns real data for a handful of fixed demo
# symbols (e.g. IBM) -- fine for local testing, not for real use.
ALPHA_VANTAGE_API_KEY=

# Resend (resend.com) -- sends the contact form (backend/contact/routes/
# contact.py) and Alert emails (backend/alerts/, confirmation + daily
# digest). All three are no-ops (contact form: 500; alerts: the alert is
# rolled back and the create request fails) if these aren't set.
RESEND_API_KEY=
EMAIL_FROM=alerts@yourdomain.com
EMAIL_FROM_NAME=Gut Shtick

# Shared secret for cron-triggered endpoints meant to be hit by a real
# external scheduler (cron-job.org or similar), not a logged-in user --
# see security.py's cron_secret_required. Currently used by
# backend/business/routes/social.py's POST /social/cron/publish-due and
# backend/alerts/routes/alert.py's POST /alerts/cron/send-digests. Point an
# external scheduler at the latter every ~15 minutes (not just once a day --
# the endpoint itself decides whether it's actually time to send, against
# the super-admin-editable AlertDigestSchedule row; see
# _maybe_run_scheduled_digest() in that file), with this value in an
# X-Cron-Secret header, to get tighter timing than the opportunistic
# fallback alone gives. Any long random string; blank disables both routes
# entirely.
CRON_SECRET=

# Where an Alert's confirm/unsubscribe email links point -- one shared pair
# of pages on the main site for every alert, regardless of which site's
# search created it. Defaults to the real production URL if unset.
MAIN_SITE_URL=https://www.gutshtick.com

# Comma-separated list of frontend origins allowed by CORS (no trailing slashes)
# Include every domain the frontend is served from -- the consumer site AND
# every sub-site domain (Good Shtick Business, Gut Estates, ...), e.g.:
# https://yourdomain.com,https://goodshtickbusiness.com,https://gutestates.com
FRONTEND_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000
